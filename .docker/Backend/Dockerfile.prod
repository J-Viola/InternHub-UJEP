ARG PY_VERSION=3.11
FROM python:${PY_VERSION}-slim

WORKDIR /app/backend

# Install system dependencies (needed for psycopg2, etc.)
RUN apt-get update && apt-get install -y \
    build-essential \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements
COPY backend/requirements.txt .

# Install dependencies
RUN pip install --no-cache-dir -r requirements.txt

# Copy application code
COPY backend/ .

# Entrypoint (migrate + collectstatic jen pro gunicorn, bez demo větve — A-23)
COPY .docker/Backend/entrypoint.prod.sh /entrypoint.prod.sh
RUN chmod +x /entrypoint.prod.sh

# Neprivilegovaný uživatel; adresáře svazků (storage, logs, staticfiles) vlastní appuser,
# takže nově vytvořené pojmenované svazky zdědí jeho vlastnictví.
RUN mkdir -p /app/backend/logs /app/backend/storage /app/backend/staticfiles \
    && addgroup --system appgroup \
    && adduser --system --ingroup appgroup appuser \
    && chown -R appuser:appgroup /app/backend

USER appuser

EXPOSE 8000

ENV GUNICORN_WORKERS=3

ENTRYPOINT ["/entrypoint.prod.sh"]
# Počet workerů: jediné místo pravdy je GUNICORN_WORKERS (výchozí 3, lze přepsat v compose/.env)
CMD ["sh", "-c", "exec gunicorn app.wsgi:application --bind 0.0.0.0:8000 --workers ${GUNICORN_WORKERS}"]
